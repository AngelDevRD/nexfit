ENV=development
DATABASE_URL=postgresql+psycopg2://appgym:appgym@localhost:5432/appgym
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Opcional -- habilita POST /api/v1/coach/chat (Gemelo Digital). Sin esto, el endpoint
# responde 503 explicando que falta configurar el proveedor de IA.
# Cualquier proveedor OpenAI-compatible sirve. Por defecto: Groq (gratis, rapido).
#   Groq:       https://api.groq.com/openai/v1   modelo: llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1     modelo: openai/gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
